# Puerto donde escucha el servidor
PORT=3002

# Host (0.0.0.0 = todas las interfaces de red, incluyendo LAN)
HOST=0.0.0.0

# Entorno: development | production
NODE_ENV=production

# Ruta al archivo SQLite (relativa a la raíz del proyecto)
DB_PATH=data/planning.db

# CORS: * permite cualquier origen (LAN). En producción pública restringir a dominio.
CORS_ORIGIN=*

# Secreto para firmar JWTs — cambiar por un string largo y aleatorio en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
